---
import { processSteps } from '@/content/process';
import Activity from '@/assets/icons/activity.svg';
import ChevronLeft from '@/assets/icons/chevron-left.svg';
import ClipboardCheck from '@/assets/icons/clipboard-check.svg';
import DraftingCompass from '@/assets/icons/drafting-compass.svg';
import HardHat from '@/assets/icons/hard-hat.svg';
import ShieldBolt from '@/assets/icons/shield-bolt.svg';

const icons = {
  consultation: ClipboardCheck,
  design: DraftingCompass,
  construction: HardHat,
  lightning: ShieldBolt,
  monitoring: Activity,
};
---

<div class="section-header">
  <p class="eyebrow">Scope of works</p>
  <h2>Services</h2>
  <p class="section-header__lead">
    From first site visit to the meter reading years later — one crew, one line
    of responsibility.
  </p>
</div>

<div class="services">
  <div class="services__wrap" style={`--count:${processSteps.length}`}>
    <div class="services__panel">
      <div class="services__cells" aria-hidden="true"></div>
      <div class="services__sheen" aria-hidden="true"></div>
      <span class="services__bolt services__bolt--tl" aria-hidden="true"></span>
      <span class="services__bolt services__bolt--tr" aria-hidden="true"></span>
      <span class="services__bolt services__bolt--bl" aria-hidden="true"></span>
      <span class="services__bolt services__bolt--br" aria-hidden="true"></span>

      {
        processSteps.map((step, i) => {
          const Icon = icons[step.id as keyof typeof icons];
          const label = `${String(i + 1).padStart(2, '0')} ${(step.name.split(' ')[0] ?? step.name).toUpperCase()}`;

          return (
            <div
              class={`services__node services__node--${step.id}`}
              style={`left:${step.panel.x}%;top:${step.panel.y}%`}
              aria-hidden="true"
            >
              <span class="services__chip">
                <Icon width={18} height={18} stroke-width={1.6} />
              </span>
              <span class="services__node-label">{label}</span>
            </div>
          );
        })
      }
    </div>

    <ol class="services__list">
      {
        processSteps.map((step, i) => (
          <li class={`services__row services__row--${step.id}`}>
            <span class="services__row-idx">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="services__row-name">{step.name}</span>
            <p class="services__row-desc">{step.summary}</p>
          </li>
        ))
      }

      <span class="services__needle" aria-hidden="true">
        <ChevronLeft width={22} height={22} stroke-width={1.75} />
      </span>
    </ol>
  </div>
</div>
