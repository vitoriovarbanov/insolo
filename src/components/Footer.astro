---
import { site } from '@/content/site';

const copyright = `© ${site.foundingYear}–${new Date().getFullYear()} ${site.legalName}`;
---

<footer class="site-footer container section--ruled">
  <div class="grid" style="--grid-min: 14rem">
    <div class="stack stack--tight">
      <p class="label">{site.name}</p>
      <p>{site.description}</p>
    </div>

    <div class="stack stack--tight">
      <p class="label">Area served</p>
      <p>{site.areaServed.join(', ')}</p>
    </div>
  </div>

  <p class="label site-footer__legal">{copyright}</p>
</footer>
