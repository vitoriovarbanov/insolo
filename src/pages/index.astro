---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Services from '@/components/Services.astro';
import Projects from '@/components/Projects.astro';
import Method from '@/components/Method.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/content/site';
---

<Base title={`${site.name} — solar photovoltaic design and installation`}>
  <a class="visually-hidden button button--ghost" href="#main">
    Skip to main content
  </a>

  <Header />

  <main id="main">
    <Hero />

    <section class="container section section--ruled" id="services" data-reveal>
      <Services />
    </section>

    <section class="container section section--ruled" id="projects" data-reveal>
      <Projects />
    </section>

    <section class="container section section--ruled" id="method" data-reveal>
      <Method />
    </section>

    <section class="container section section--ruled" id="contact" data-reveal>
      <Contact />
    </section>
  </main>

  <Footer />
</Base>

<script>
  import { initScrollReveal } from '@/scripts/reveal';
  import { trackActiveSection } from '@/scripts/active-section';
  import { initMethodAccordion } from '@/scripts/method';

  initScrollReveal();
  trackActiveSection();
  initMethodAccordion();
</script>
