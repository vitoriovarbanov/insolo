# Cloudflare reads this from the output root and applies the rules
# at the edge. Order matters: later, more specific rules win.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Astro content-hashes everything under /_astro, so the filename changes
# whenever the bytes do. That makes a one-year immutable cache safe —
# and it covers the self-hosted fonts, which are the largest payload.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate. Caching HTML is the classic reason a deploy
# appears not to have shipped: the CDN keeps serving the old shell,
# which references asset filenames that no longer exist.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Unhashed public files: short cache, but not none.
/og/*
  Cache-Control: public, max-age=86400
